{
  "name": "@numiko/site-alert",
  "description": "Site alerts",
  "version": "1.1.0",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@bitbucket.org/numiko/site-alert.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest --run --reporter junit --outputFile ./reports/results.xml --coverage.enabled --coverage.include lib --coverage.reporter=html --coverage.reportsDirectory ./reports/",
    "release": "release-it"
  },
  "main": "./dist/SiteAlert.umd.js",
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/SiteAlert.es.js",
      "require": "./dist/SiteAlert.umd.js"
    }
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "js-cookie": "^3.0.5"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.9.0",
    "@vitest/coverage-v8": "^2.1.3",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "happy-dom": "^20.0.4",
    "release-it": "^19.0.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^5.4.9",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^2.1.3"
  },
  "release-it": {
    "$schema": "https://unpkg.com/release-it/schema/release-it.json",
    "hooks": {
      "before:init": [
        "vitest run"
      ],
      "after:bump": [
        "npm run build"
      ]
    }
  }
}
