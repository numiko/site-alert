{
  "name": "@numiko/site-alert",
  "description": "Site alerts",
  "version": "1.2.0",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@bitbucket.org/numiko/site-alert.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest --run --reporter junit --outputFile ./reports/results.xml --coverage.enabled --coverage.include lib --coverage.reporter=html --coverage.reportsDirectory ./reports/",
    "generate-docs": "typedoc lib/SiteAlert.ts",
    "deploy-docs": "netlify deploy --dir=docs --alias=v$(node -p \"require('./package.json').version\")",
    "release": "release-it"
  },
  "main": "./dist/SiteAlert.umd.js",
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/SiteAlert.es.js",
      "require": "./dist/SiteAlert.umd.js"
    }
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "gsap": "^3.15.0",
    "js-cookie": "^3.0.8"
  },
  "devDependencies": {
    "@j-ulrich/release-it-regex-bumper": "^5.6.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/js-cookie": "^3.0.6",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.2",
    "netlify-cli": "^23.9.1",
    "release-it": "^21.0.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^4.1.0"
  },
  "release-it": {
    "$schema": "https://unpkg.com/release-it/schema/release-it.json",
    "plugins": {
      "@j-ulrich/release-it-regex-bumper": {
        "out": [
          {
            "file": "README.md",
            "search": "\\d+-\\d+-\\d+",
            "replace": "{{major}}-{{minor}}-{{patch}}"
          }
        ]
      }
    },
    "npm": {
      "publish": true,
      "publishArgs": [
        "--access",
        "public"
      ]
    },
    "hooks": {
      "before:init": [
        "vitest run"
      ],
      "after:bump": [
        "npm run generate-docs",
        "npm run build",
        "npm run deploy-docs"
      ]
    }
  }
}
